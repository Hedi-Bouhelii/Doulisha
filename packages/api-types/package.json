{
  "name": "@doulisha/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "Type declarations of the tRPC API (AppRouter), bundled into one file for the mobile app",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
