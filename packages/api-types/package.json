    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@doulisha/api": "workspace:*",
    "@doulisha/config": "workspace:*",
    "@trpc/server": "^11.19.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "catalog:"
  }
}
