{
  "name": "@doulisha/api",
  "version": "0.0.0",
  "private": true,
  "description": "tRPC routers, services (business logic) and permissions",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run src/integration --testTimeout=300000"
  },
  "devDependencies": {
    "@doulisha/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@doulisha/auth": "workspace:*",
    "@doulisha/db": "workspace:*",
    "@doulisha/i18n": "workspace:*",
    "@doulisha/notifications": "workspace:*",
    "@doulisha/payments": "workspace:*",
    "@doulisha/storage": "workspace:*",
    "@doulisha/templates": "workspace:*",
    "@doulisha/validators": "workspace:*",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "catalog:",
    "superjson": "^2.2.6",
    "zod": "catalog:"
  }
}
