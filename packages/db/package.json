{
  "name": "@doulisha/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, seed and query helpers for Neon PostgreSQL",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@doulisha/templates": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@doulisha/config": "workspace:*",
    "@doulisha/i18n": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
