# Local values live in the root .env.local (gitignored). `neon link` writes the
# database variables there; add the others by hand.
# Every variable is validated with Zod in the app's env.ts. Keep this file in sync.
# Development uses mocks: no real SMS, payment or email credentials are needed
# before Phase 6.

# --- Web (apps/web) -------------------------------------------------------
# Public URL of the web app, used for links, Open Graph and smart links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Neon, written by `neon link`; database name must be Doulisha) ---
# Pooled connection: runtime queries (HTTP driver and WebSocket Pool)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.c-7.us-east-2.aws.neon.tech/Doulisha?sslmode=require&channel_binding=require
# Direct connection: migrations (drizzle-kit)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-xxx.c-7.us-east-2.aws.neon.tech/Doulisha?sslmode=require&channel_binding=require
# Written by `neon link`; not used by the app
# NEON_BRANCH=production
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=

# --- Auth (Better Auth) ----------------------------------------------------
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Defaults to NEXT_PUBLIC_APP_URL
# BETTER_AUTH_URL=http://localhost:3000
# Social sign-in: each provider appears only when both values are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# Only "mock" exists until Phase 6 (codes appear in /fr/dev/outbox)
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock

# --- CI only ----------------------------------------------------------------
# Builds without secrets (pages that need them are dynamic)
# SKIP_ENV_VALIDATION=1

# --- Added in later phases -----------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BUCKET=
# R2_PRIVATE_BUCKET=
# PAYMENT_PROVIDER=mock
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# RESEND_API_KEY=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
