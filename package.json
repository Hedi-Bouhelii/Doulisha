{
  "name": "doulisha",
  "private": true,
  "description": "Doulisha \u00e2\u20ac\u201d the social platform for events and activities in Tunisia",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm format:check && turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:use-doulisha": "node scripts/use-doulisha-db.mjs",
    "db:generate": "pnpm --filter @doulisha/db db:generate",
    "db:migrate": "pnpm --filter @doulisha/db db:migrate",
    "db:seed": "pnpm --filter @doulisha/db db:seed",
    "e2e": "pnpm --filter @doulisha/web e2e"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
